# Copy to .env and fill in. Never commit .env (the hackathon repo must be public).

# --- Meta Model API (the $150 credits) ---
# Key and base URL come from the Meta Model API quickstart: https://dev.meta.ai/docs/quickstart
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_SPARK_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0

# --- Baseten (the $100 credits, Muse Spark Open) ---
BASETEN_API_KEY=
# OpenAI-compatible endpoint; confirm against Baseten's Quickstart page.
BASETEN_BASE_URL=https://inference.baseten.co/v1
# The docs say muse-spark-open, but the hackathon guide says to use this one:
BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- Local settings ---
CACHE_DIR=.cache
# Stop the pipeline if estimated spend passes this (USD)
SPEND_GUARD_USD=100
